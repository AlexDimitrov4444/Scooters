@model List<Scooters.Models.Order>
@{
    ViewData["Title"] = "Моите поръчки";
}

<h2 class="mb-4">📦 Моите поръчки</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Нямате направени поръчки.
        <a asp-controller="Product" asp-action="Index" class="alert-link">Разгледайте тротинетките →</a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Номер</th>
                        <th>Дата</th>
                        <th>Статус</th>
                        <th class="text-end">Сума</th>
                        <th class="text-center">Детайли</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var shortId = order.Id.ToString().Substring(0, 8).ToUpper();
                        <tr>
                            <td class="ps-3 fw-semibold">#@shortId</td>
                            <td>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @{
                                    var (badgeClass, label) = order.Status switch
                                    {
                                        Scooters.Models.OrderStatus.Pending    => ("secondary", "Изчакваща"),
                                        Scooters.Models.OrderStatus.Processing => ("primary",   "В обработка"),
                                        Scooters.Models.OrderStatus.Shipped    => ("info",      "Изпратена"),
                                        Scooters.Models.OrderStatus.Delivered  => ("success",   "Доставена"),
                                        Scooters.Models.OrderStatus.Cancelled  => ("danger",    "Отказана"),
                                        _ => ("secondary", "Неизвестен")
                                    };
                                }
                                <span class="badge bg-@badgeClass">@label</span>
                            </td>
                            <td class="text-end">@order.Total.ToString("F2") €</td>
                            <td class="text-center">
                                <a asp-controller="Account" asp-action="OrderDetails" asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-primary">Виж</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

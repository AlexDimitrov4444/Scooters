@model IEnumerable<Product>
@{
    ViewData["Title"] = "Начало";
    var products = Model.ToList();
    var count = products.Count;
}

<section class="hero-banner mb-5">
    <div class="hero-copy">
        <p class="hero-kicker">Електрическа мобилност</p>
        <h1>VoltRide — електрически тротинетки за града</h1>
        <p class="lead">Леки, бързи и готови за ежедневието. Разгледайте каталога или влезте в профила си.</p>

        <a class="btn btn-warning btn-lg me-2" asp-controller="Product" asp-action="Index">Каталог</a>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-outline-light btn-lg" asp-controller="Product" asp-action="Create">+ Добави модел</a>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Вход</a>
        }

        <div class="hero-stats">
            <div class="hero-stat">
                <strong>@count</strong>
                <span>модела в каталога</span>
            </div>
            @if (count > 0)
            {
                <div class="hero-stat">
                    <strong>@products.Min(p => p.Price).ToString("0") eur.</strong>
                    <span>начална цена</span>
                </div>
                <div class="hero-stat">
                    <strong>@products.Max(p => p.RangeKm) км</strong>
                    <span>най-дълъг пробег</span>
                </div>
            }
        </div>
    </div>
</section>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Популярни модели</h2>
    <a asp-controller="Product" asp-action="Index">Виж всички →</a>
</div>

@if (!products.Any())
{
    <div class="empty-state">
        <p class="mb-2 fs-1">🛴</p>
        <h3 class="h5">Все още няма модели</h3>
        <p class="text-muted mb-3">Администраторът все още не е добавил продукти.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in products.Take(4))
        {
            <div class="col-md-6 col-lg-3">
                <div class="card scooter-card h-100">
                    <div class="scooter-media">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="scooter-visual h-100">🛴</div>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-controller="Product" asp-action="UploadImage" asp-route-id="@item.Id"
                                  method="post" enctype="multipart/form-data"
                                  class="image-upload-btn">
                                @Html.AntiForgeryToken()
                                <label>
                                    📷 Смени снимка
                                    <input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif"
                                           class="d-none js-auto-submit" />
                                </label>
                            </form>
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h3 class="h5">@item.Name</h3>
                        <p class="text-muted small">@item.Description</p>
                        <p class="price-tag mb-1">@item.Price.ToString("0.00") eur.</p>
                        <p class="small mb-3">
                            <span class="spec-badge">@item.RangeKm км</span>
                            <span class="spec-badge">@item.MaxSpeedKmh км/ч</span>
                        </p>
                        <div class="mt-auto d-flex flex-wrap gap-1">
                            <a class="btn btn-sm btn-dark"
                               asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@item.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-warning">🛒</button>
                            </form>
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id">✏</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

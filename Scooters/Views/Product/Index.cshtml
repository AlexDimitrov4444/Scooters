@model IEnumerable<Product>
@{
    ViewData["Title"] = "Тротинетки";
    var search = ViewData["Search"] as string ?? string.Empty;
    var sort = ViewData["Sort"] as string ?? "name";
    var products = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">Каталог електрически тротинетки</h1>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-warning" asp-controller="Product" asp-action="Create">+ Добави модел</a>
    }
</div>

<form method="get" class="catalog-toolbar mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label" for="q">Търсене</label>
            <input id="q" name="q" value="@search" class="form-control" placeholder="Име или описание" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="sort">Подреди</label>
            <select id="sort" name="sort" class="form-select">
                <option value="name"       selected="@(sort=="name"       ?"selected":null)">По име</option>
                <option value="price_asc"  selected="@(sort=="price_asc"  ?"selected":null)">Цена: ниска → висока</option>
                <option value="price_desc" selected="@(sort=="price_desc" ?"selected":null)">Цена: висока → ниска</option>
                <option value="range"      selected="@(sort=="range"      ?"selected":null)">Най-дълъг пробег</option>
                <option value="speed"      selected="@(sort=="speed"      ?"selected":null)">Най-висока скорост</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100">Покажи</button>
        </div>
    </div>
</form>

@if (!products.Any())
{
    <div class="empty-state">
        <p class="mb-2 fs-1">🔍</p>
        <h2 class="h5">Няма намерени модели</h2>
        <p class="text-muted mb-0">Опитайте с друга дума или изчистете търсенето.</p>
    </div>
}
else
{
    <p class="text-muted small mb-3">Показани: @products.Count</p>
    <div class="row g-4">
        @foreach (var item in products)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card scooter-card h-100">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height:200px;object-fit:cover;">
                    }
                    else
                    {
                        <div class="scooter-visual">⚡🛴</div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h2 class="h5">@item.Name</h2>
                        <p class="text-muted small">@item.Description</p>
                        <p class="price-tag mb-2">@item.Price.ToString("0.00") eur.</p>
                        <p class="mb-3">
                            <span class="spec-badge">@item.RangeKm км</span>
                            <span class="spec-badge">@item.MaxSpeedKmh км/ч</span>
                        </p>
                        <div class="mt-auto d-flex flex-wrap gap-1">
                            <a class="btn btn-sm btn-dark"
                               asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@item.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-warning btn-sm">🛒 Кошница</button>
                            </form>
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id">✏ Редакция</a>
                                <form asp-action="Delete" asp-controller="Product" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Изтриване на @item.Name?')">🗑</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@model Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="card scooter-card">
    <div class="row g-0">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="col-md-5">
                <img src="@Model.ImageUrl" class="img-fluid rounded-start w-100 h-100"
                     alt="@Model.Name" style="object-fit: cover; min-height: 280px;">
            </div>
        }
        else
        {
            <div class="col-md-5 scooter-visual-lg">🛴</div>
        }

        <div class="col-md-7">
            <div class="card-body p-4">
                <p class="text-muted text-uppercase small mb-1">Електрическа тротинетка</p>
                <h1 class="h3">@Model.Name</h1>
                <p class="lead">@Model.Description</p>
                <p class="price-tag mb-3">@Model.Price.ToString("0.00") eur.</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Пробег</dt>
                    <dd class="col-sm-8">@Model.RangeKm км с едно зареждане</dd>

                    <dt class="col-sm-4">Макс. скорост</dt>
                    <dd class="col-sm-8">@Model.MaxSpeedKmh км/ч</dd>
                </dl>

                <a class="btn btn-dark mt-4" asp-action="Index">Назад към каталога</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-warning mt-4 ms-2"
                       asp-action="Edit" asp-route-id="@Model.Id">Редакция</a>
                }
            </div>
        </div>
    </div>
</div>

@model List<Scooters.Models.Order>
@{
    ViewData["Title"] = "Всички поръчки";
    var page       = (int)(ViewData["Page"]       ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
}

<div class="d-flex gap-2 mb-4 flex-wrap">
    <a href="/Admin" class="btn btn-outline-secondary btn-sm">🏠 Дашборд</a>
    <a asp-controller="Admin" asp-action="Orders"   class="btn btn-dark btn-sm">📋 Поръчки</a>
    <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-secondary btn-sm">📦 Продукти</a>
    <a asp-controller="Admin" asp-action="Users"    class="btn btn-outline-secondary btn-sm">👥 Потребители</a>
</div>

<h2 class="mb-4">📋 Всички поръчки</h2>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-3">Номер</th>
                    <th>Клиент</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th class="text-end">Сума</th>
                    <th class="text-center">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    var shortId = order.Id.ToString().Substring(0, 8).ToUpper();
                    var (bc, lbl) = order.Status switch
                    {
                        Scooters.Models.OrderStatus.Pending    => ("secondary", "Изчакваща"),
                        Scooters.Models.OrderStatus.Processing => ("primary",   "В обработка"),
                        Scooters.Models.OrderStatus.Shipped    => ("info",      "Изпратена"),
                        Scooters.Models.OrderStatus.Delivered  => ("success",   "Доставена"),
                        Scooters.Models.OrderStatus.Cancelled  => ("danger",    "Отказана"),
                        _                                      => ("secondary", "Неизвестен")
                    };
                    <tr>
                        <td class="ps-3 fw-semibold">#@shortId</td>
                        <td>@(order.User?.FullName ?? "—")</td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td><span class="badge bg-@bc">@lbl</span></td>
                        <td class="text-end">@order.Total.ToString("F2") €</td>
                        <td class="text-center">
                            <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@order.Id"
                               class="btn btn-sm btn-outline-primary">Виж</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="Admin" asp-action="Orders" asp-route-page="@(page - 1)">←</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-controller="Admin" asp-action="Orders" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-controller="Admin" asp-action="Orders" asp-route-page="@(page + 1)">→</a>
            </li>
        </ul>
    </nav>
}

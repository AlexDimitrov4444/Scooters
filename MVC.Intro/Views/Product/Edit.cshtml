@model Product
@{
    ViewData["Title"] = "Редакция: " + Model.Name;
}

<h1>Редактирай тротинетка</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RangeKm" class="form-label"></label>
                <input asp-for="RangeKm" class="form-control" />
                <span asp-validation-for="RangeKm" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MaxSpeedKmh" class="form-label"></label>
                <input asp-for="MaxSpeedKmh" class="form-control" />
                <span asp-validation-for="MaxSpeedKmh" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Снимка</label>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.ImageUrl" alt="@Model.Name" style="max-height: 150px; object-fit: cover;" class="img-thumbnail" />
                        <div class="form-text">Качете нова снимка, за да замените текущата.</div>
                    </div>
                    <input type="hidden" asp-for="ImageUrl" />
                }
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>

            <button type="submit" class="btn btn-warning">Запази промените</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

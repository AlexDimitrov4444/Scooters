@* Моделът е колекция от продукти — подава се от ProductController.Index() *@
@model IEnumerable<Product>
@{
    ViewData["Title"] = "Тротинетки";
}

@* Заглавие и бутон за добавяне (само за влезли потребители) *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Каталог електрически тротинетки</h1>

    @* Показваме различни бутони според това дали потребителят е влязъл *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* Влязъл потребител вижда бутон за добавяне *@
        <a class="btn btn-warning" asp-controller="Product" asp-action="Create">Добави модел</a>
    }
    else
    {
        @* Невлязъл потребител вижда покана за вход *@
        <a class="btn btn-outline-dark" asp-controller="Account" asp-action="Login">Влез, за да добавяш</a>
    }
</div>

@* Bootstrap grid — 3 колони на голям екран *@
<div class="row g-4">
    @* Обхождаме всеки продукт и генерираме карта *@
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card scooter-card h-100">

                @* Снимка на продукта — ако има такава, иначе емоджи *@
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    @* object-fit: cover — запълва пространството без разтягане *@
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                }
                else
                {
                    @* Резервен вариант без снимка *@
                    <div class="scooter-visual">⚡🛴</div>
                }

                @* Информация за продукта *@
                <div class="card-body">
                    <h2 class="h5">@item.Name</h2>
                    <p class="text-muted">@item.Description</p>
                    <ul class="list-unstyled small">
                        <li>Цена: <strong>@item.Price.ToString("0.00") лв.</strong></li>
                        <li>Пробег: @item.RangeKm км</li>
                        <li>Макс. скорост: @item.MaxSpeedKmh км/ч</li>
                    </ul>

                    @* Бутон към детайлите на продукта *@
                    <a class="btn btn-sm btn-dark me-2"
                       asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">Детайли</a>

                    @* Бутоните за редакция и изтриване са само за влезли потребители *@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @* Бутон за редактиране на продукта *@
                        <a class="btn btn-sm btn-warning me-2"
                           asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id">Редакция</a>

                        @* Форма за изтриване — използва POST за да е защитена *@
                        <form asp-action="Delete" asp-controller="Product" asp-route-id="@item.Id"
                              method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

@* Моделът е един продукт — подава се от ProductController.Details(id) *@
@model Product
@{
    @* Заглавието на страницата е името на продукта *@
    ViewData["Title"] = Model.Name;
}

@* Карта с детайлна информация — снимка вляво, данни вдясно *@
<div class="card scooter-card">
    <div class="row g-0">

        @* Снимка — ако съществува, показваме я в лявата колона *@
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="col-md-4">
                @* h-100 — снимката заема цялата височина на картата *@
                <img src="@Model.ImageUrl" class="img-fluid rounded-start h-100"
                     alt="@Model.Name" style="object-fit: cover;">
            </div>
        }
        else
        {
            @* Ако няма снимка — показваме голямо емоджи *@
            <div class="col-md-4 scooter-visual-lg">🛴</div>
        }

        @* Дясна колона с технически характеристики *@
        <div class="col-md-8">
            <div class="card-body">
                <h1 class="h3">@Model.Name</h1>
                <p>@Model.Description</p>

                @* Характеристики в двуколонен layout (dl/dt/dd) *@
                <dl class="row mb-0">
                    <dt class="col-sm-4">Цена</dt>
                    <dd class="col-sm-8">@Model.Price.ToString("0.00") лв.</dd>

                    <dt class="col-sm-4">Пробег</dt>
                    <dd class="col-sm-8">@Model.RangeKm км</dd>

                    <dt class="col-sm-4">Макс. скорост</dt>
                    <dd class="col-sm-8">@Model.MaxSpeedKmh км/ч</dd>
                </dl>

                @* Бутон за връщане към каталога *@
                <a class="btn btn-dark mt-3" asp-action="Index">Назад към каталога</a>

                @* Бутонът за редакция се вижда само от влезли потребители *@
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-warning mt-3 ms-2"
                       asp-action="Edit" asp-route-id="@Model.Id">Редакция</a>
                }
            </div>
        </div>
    </div>
</div>
